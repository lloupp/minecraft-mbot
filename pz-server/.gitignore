# Tudo que o Forge/servidor gera ou baixa fica fora do git.
/libraries/
/mods/
/mods-removidos/
/world/
/backups/
/logs/
/crash-reports/
/debug/
/modernfix/
/tacz/
/local/
/eula.txt
/forge-installer.jar
/forge-install.log
/forge-installer.jar.log
/run.sh
/run.bat
/user_jvm_args.txt
/*.json
!/mods.lock.json
/*.part
__pycache__/

# Configs geradas pelos mods: só versionamos as que ajustamos (ver CONFIGURATION.md).
/config/*
!/config/hordes-common.toml
!/config/hordes/
!/config/incontrol/
!/config/zombieawareness/
!/config/coldsweat/
!/config/spoiled-common.toml
!/config/sereneseasons/
!/config/lostcities/
/config/lostcities/*
!/config/lostcities/profiles/
/config/lostcities/profiles/*
!/config/lostcities/profiles/apocalipse.json
/config/incontrol/*
!/config/incontrol/spawn.json
!/config/incontrol/spawner.json
!/config/incontrol/phases.json
/config/zombieawareness/*
!/config/zombieawareness/MobLists.toml
/config/coldsweat/*
!/config/coldsweat/main.toml
/config/sereneseasons/*
!/config/sereneseasons/seasons.toml
