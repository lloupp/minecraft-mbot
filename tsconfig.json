{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["core/**/*.js", "app/**/*.js"]
}
