# Local-only autonomous startup. Configure your trusted Minecraft server.
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.20.1
MINECRAFT_BOT_NAME=eduardo_bot
# Requires saved colony base, stock and workers; refuses auto if not ready.
MBOT_COLONY_AUTOSTART=1
# Optional autonomous exploration of main companion; off by default.
MBOT_COMPANION_AUTOSTART=1
MBOT_JULIA_AUTHORITY=0
MBOT_LAYA_SHADOW=0
MBOT_JULIA_SHADOW=0
MBOT_TOOL_API=0
MBOT_DASHBOARD=0
STATUS_SERVER=0
MINECRAFT_LAN_ANNOUNCE=0
