 async function mineBlocks(bot, predicate, count, isCancelled, { onAttempt = () => {}, allowedPositions = null, preferInReach = false, requireInReach = false, retryPickup = false, clearLeaves = false, anchor = null, beforeAction = () => {} } = {}) {
