+// Quantas das 4 células vizinhas (mesmo nível) têm folha logo acima: 0 = base livre, 4 = anel fechado.
+function leafRoofedSides(bot, pos) {
+  return [[1, 0], [-1, 0], [0, 1], [0, -1]]
+    .filter(([x, z]) => bot.blockAt(pos.offset(x, 1, z))?.name?.endsWith('_leaves')).length
+}
