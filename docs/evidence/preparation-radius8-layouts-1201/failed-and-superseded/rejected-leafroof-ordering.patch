+++ b/test/gather.test.js
@@ -375,3 +375,26 @@ test('clearLeaves: se o raio já atinge o alvo no início da iteração (atualiz
     { preferInReach: true, requireInReach: true, clearLeaves: true, allowedPositions: approved }), 1)
   assert.equal(dug, 1)
