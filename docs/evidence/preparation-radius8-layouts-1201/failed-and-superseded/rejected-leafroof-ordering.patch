+
+test('clearLeaves prefere o tronco aprovado menos coberto por folhas baixas; sem a opção a ordem não muda', async () => {
+  const ringed = new Vec3(2, 64, 2)
+  const open = new Vec3(8, 64, 2)
+  const mined = []
+  const build = () => {
+    const bot = collectionBot()
+    bot.findBlocks = () => []
+    bot.blockAt = (p) => {
+      if (p.equals(ringed) || p.equals(open)) return { name: 'oak_log', position: p }
+      if (p.y === 65 && Math.abs(p.x - ringed.x) + Math.abs(p.z - ringed.z) === 1) return { name: 'oak_leaves', position: p }
+      return { name: 'air', position: p }
+    }
+    bot.dig = async (block) => { mined.push(block.position.toString()); bot.inventory.items().push({ name: 'oak_log', count: 1 }) }
+    return bot
+  }
+  const approved = new Set([ringed.toString(), open.toString()])
+  const run = (options) => gather.mineBlocks(build(), n => n === 'oak_log', 1, () => false, { allowedPositions: approved, ...options })
+  assert.equal(await run({}), 1)
+  assert.equal(mined.pop(), ringed.toString())          // comportamento anterior: primeiro da lista aprovada
+  assert.equal(await run({ clearLeaves: true }), 1)
+  assert.equal(mined.pop(), open.toString())            // anel fechado fica por último
+})
