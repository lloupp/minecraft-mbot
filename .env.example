# Server connection
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_OWNER=eduardo
MINECRAFT_PROFILE=vanilla1201
MINECRAFT_LAN_ANNOUNCE=1

# Feature flags
MBOT_PLUGINS=1
MBOT_PLUGINS_SKIP=
MBOT_VIEWER_PORT=0
MBOT_INVENTORY_PORT=0
STATUS_PORT=3080
STATUS_SERVER=1
MBOT_MELEE=manual
MBOT_STATEMACHINE=0
MBOT_BUILDER_EXPERIMENTAL=0

# Experimental decision client / benchmark.
# The live runtime is not wired to Laya yet; default behavior is unchanged.
MBOT_DECISION_ENGINE=deterministic
LAYA_DECISION_URL=http://127.0.0.1:8765/decision
LAYA_PLAYER_LOOP_URL=http://127.0.0.1:8765/choose
JULIA_PLAYER_LOOP_URL=http://127.0.0.1:8768/choose
ANDY_PLAYER_LOOP_URL=http://127.0.0.1:8767/choose
LAYA_DECISION_TIMEOUT_MS=4000
# Gauntlet only; model proposals are not wired to Mineflayer/runtime.
NANOANDY_PLAYER_LOOP_URL=http://127.0.0.1:8766/choose

# Andy-4 local through Ollama. The adapter keeps prompts compact and only accepts supplied candidates.
OLLAMA_URL=http://127.0.0.1:11434
ANDY_MODEL=sweaterdog/andy-4:micro-q8_0
ANDY_NUM_CTX=4096
ANDY_HOST=127.0.0.1
ANDY_PORT=8767
PLAYER_LOOP_REPEATS=5
PLAYER_LOOP_TIMEOUT_MS=4000
# Leave blank unless calibrated outside the evaluation set.
LAYA_DECISION_THRESHOLD=

# Laya shadow mode: observes real decisions in parallel and only logs them.
# It never controls the bot — see docs/LAYA_SHADOW_MODE.md before enabling.
MBOT_LAYA_SHADOW=0
LAYA_SHADOW_LOG=.data/laya-shadow.jsonl
LAYA_SHADOW_TIMEOUT_MS=3000
LAYA_SHADOW_MAX_CONCURRENT=1
LAYA_SHADOW_BREAKER_THRESHOLD=5
LAYA_SHADOW_BREAKER_COOLDOWN_MS=60000

# Julia-1 shadow mode: observes real decisions in parallel and only logs them
# (no execution authority). See docs/JULIA_SHADOW_MODE.md.
MBOT_JULIA_SHADOW=0
JULIA_SHADOW_LOG=.data/julia-shadow.jsonl
JULIA_SHADOW_TIMEOUT_MS=4000
# 1 descarta decisões simultâneas de vários workers; use 4 com 5+ workers.
JULIA_SHADOW_MAX_CONCURRENT=4
JULIA_SHADOW_BREAKER_THRESHOLD=5
JULIA_SHADOW_BREAKER_COOLDOWN_MS=60000

# Logging and data
COLONY_EVENT_LOG=.data/colony-events.jsonl
COLONY_EVENT_LOG_MAX=50000
COLONY_PROOF_FILE=.data/colony-proof.json
COLONY_STATE_FILE=.data/colony-state.json
RUN_ID=
