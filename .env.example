# Server connection
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_OWNER=eduardo
MINECRAFT_BOT_NAME=eduardo_bot
MINECRAFT_PROFILE=vanilla1201
# Anuncie somente se o servidor também roda neste PC.
MINECRAFT_LAN_ANNOUNCE=0

# Feature flags
MBOT_PLUGINS=1
MBOT_PLUGINS_SKIP=
MBOT_VIEWER_PORT=0
MBOT_INVENTORY_PORT=0
STATUS_PORT=3080
STATUS_SERVER=1
MBOT_MELEE=manual
MBOT_STATEMACHINE=0
MBOT_BUILDER_EXPERIMENTAL=0

# Player Loop Gauntlet V2 (benchmark offline: rules × Julia-1).
PLAYER_LOOP_REPEATS=5
PLAYER_LOOP_TIMEOUT_MS=4000

# Julia-1 shadow mode: observes real decisions in parallel and only logs them
# (no execution authority). See docs/JULIA_SHADOW_MODE.md.
MBOT_JULIA_SHADOW=0
JULIA_PLAYER_LOOP_URL=http://127.0.0.1:8768/choose
JULIA_SHADOW_LOG=.data/julia-shadow.jsonl
JULIA_SHADOW_TIMEOUT_MS=4000
# 1 (padrão) descarta decisões simultâneas de vários workers; use 4 com 5+ workers.
JULIA_SHADOW_MAX_CONCURRENT=1
JULIA_SHADOW_BREAKER_THRESHOLD=5
JULIA_SHADOW_BREAKER_COOLDOWN_MS=60000

# Logging and data
COLONY_EVENT_LOG=.data/colony-events.jsonl
COLONY_EVENT_LOG_MAX=50000
COLONY_PROOF_FILE=.data/colony-proof.json
COLONY_STATE_FILE=.data/colony-state.json
RUN_ID=

# Local worker Tool API: opt-in; deterministic executor, no model authority.
MBOT_TOOL_API=0
MBOT_TOOL_API_PORT=3091
MBOT_TASK_CHECKPOINT_FILE=.data/task-checkpoints.json
