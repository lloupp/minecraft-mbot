# Server connection
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_OWNER=eduardo
MINECRAFT_PROFILE=vanilla1201
MINECRAFT_LAN_ANNOUNCE=1

# Feature flags
MBOT_PLUGINS=1
MBOT_PLUGINS_SKIP=
MBOT_VIEWER_PORT=0
MBOT_INVENTORY_PORT=0
STATUS_PORT=3080
STATUS_SERVER=1
MBOT_MELEE=manual
MBOT_STATEMACHINE=0
