# Experimental decision engine. Default remains deterministic.
MBOT_DECISION_ENGINE=deterministic
LAYA_DECISION_URL=http://127.0.0.1:8765/decision
LAYA_DECISION_TIMEOUT_MS=4000
# Leave blank unless calibrated outside the evaluation set.
